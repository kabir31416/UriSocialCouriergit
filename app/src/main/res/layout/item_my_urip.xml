<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginTop="2dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="6dp"
    android:layout_marginHorizontal="8dp">

    <Button
        android:id="@+id/btnViewDetails"
        android:background="@drawable/btn_bg"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp">

            <TextView
                android:id="@+id/parcelcn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="CN#123456" />

            <TextView
                android:id="@+id/parcelstatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Delivered "
                android:textColor="#4CAF50"
                android:layout_marginStart="5dp"
                android:textSize="13sp"
                android:padding="2dp"
                android:background="@drawable/textview_bg2" />



        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp">

            <TextView
                android:id="@+id/recname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Sahariar Kabir"
                android:textSize="16sp"
                android:textStyle="bold"/>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                >

                <TextView
                    android:id="@+id/tvlot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lot: 1"
                    android:textColor="#000000"/>

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/parceldate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Jan 21, 2025, 04:03 PM" />



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                >

                <TextView
                    android:id="@+id/parceldc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Charge: "
                    android:textColor="#000000"/>

            </LinearLayout>
        </LinearLayout>



        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewRequests"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View Request"
            android:textColor="@android:color/white"
            android:textAllCaps="false"
            android:layout_gravity="center"
            android:backgroundTint="#086471"
            android:paddingVertical="2dp"
            style="@style/Widget.MaterialComponents.Button" />



    </LinearLayout>






</androidx.cardview.widget.CardView>
