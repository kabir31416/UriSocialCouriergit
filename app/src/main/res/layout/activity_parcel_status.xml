<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:fitsSystemWindows="true"
    android:background="@color/white">


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:background="#086471"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivBack"
                    android:background="?selectableItemBackground"
                    android:src="@drawable/ic_baseline_arrow_back_24"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tint="#FFFFFF"/>

                <TextView
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mont"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_16ssp"
                    android:text="Admin Portal"/>


            </androidx.appcompat.widget.LinearLayoutCompat>


        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_below="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:background="#F8F8F8"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">





                <!-- Track your package box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_purple_box"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Track your package"
                        android:textSize="18sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:weightSum="3"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:weightSum="2"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/etManualParcelId"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:hint="Enter Parcel ID     "
                                android:background="@drawable/search_box_bg"
                                android:padding="10dp"
                                android:textColor="#000000"
                                android:textColorHint="#DDDDDD" />

                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="2"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/btnSearchParcel"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_search"
                                android:layout_marginEnd="10dp"
                                android:layout_marginStart="20dp"
                                android:tint="#086471"
                                android:background="@drawable/circle_background"
                                android:padding="8dp" />

                            <ImageView
                                android:id="@+id/btnScanQR"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_qr"
                                android:layout_marginEnd="10dp"
                                android:tint="#086471"
                                android:background="@drawable/circle_background"
                                android:padding="8dp" />

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>


                <TextView
                    android:id="@+id/tvParcelInfo"
                    android:textSize="16sp"
                    android:textColor="#333"
                    android:layout_marginTop="16dp"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp"
                    android:layout_width="match_parent"
                    android:background="@drawable/parcelview_bg"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transit Action"
                    android:textSize="18sp"
                    android:textColor="#086471"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerStatus"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/spinner_background"
                    android:spinnerMode="dropdown"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Point "
                    android:textSize="18sp"
                    android:textColor="#086471"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerPoints"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/spinner_background"
                    android:spinnerMode="dropdown"/>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <Button
                        android:id="@+id/btnUpdateLocation"
                        android:text="Update Tracking"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#086471"
                        />



                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:padding="10dp">

                    <Button
                        android:id="@+id/btnstatusup"
                        android:text="Update Status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#086471"
                        android:layout_weight="1"/>

                    <Button
                        android:id="@+id/btnEditParcel"
                        android:text="Edit Parcel Info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#086471"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:padding="10dp">

                    <Button
                        android:id="@+id/btnAssignRider"
                        android:text="Assign Rider"
                        android:backgroundTint="#086471"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btnGenerateLabel"
                        android:text="Add Credentials"
                        android:backgroundTint="#086471"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

            </LinearLayout>


        </ScrollView>


    </androidx.appcompat.widget.LinearLayoutCompat>


</RelativeLayout>

