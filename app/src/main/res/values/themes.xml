<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ProjectUri" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorPrimary">#086471</item>
        <item name="colorPrimaryVariant">#086471</item>
        <item name="android:statusBarColor">#086471</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>


    <style name="BottomNavTextStyle" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">@font/hfont</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#b3b3b3</item>
    </style>


    <style name="AlertDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:background">@drawable/dialog_background</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textSize">16sp</item>
    </style>


    <style name="Theme.ProjectUri" parent="Base.Theme.ProjectUri" />


    <style name="EditField">
        <item name="android:background">@drawable/edit_text_bg</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">#000</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="SettingItem">
        <item name="android:textColor">#333</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:textSize">16sp</item>
    </style>



</resources>